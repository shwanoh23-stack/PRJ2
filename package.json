{
  "name": "sales-pipeline-msa",
  "version": "1.0.0",
  "private": true,
  "description": "영업 파이프라인 관리 자동화 시스템 (React + API Gateway + 경량 MSA + SQLite)",
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently -n \"GATEWAY,PIPELINE,ACTIVITY,FRONTEND\" -c \"cyan,green,yellow,magenta\" \"node services/api-gateway/src/index.js\" \"node services/pipeline-service/src/index.js\" \"node services/activity-service/src/index.js\" \"vite --port 5173\"",
    "dev:gateway": "node services/api-gateway/src/index.js",
    "dev:pipeline": "node services/pipeline-service/src/index.js",
    "dev:activity": "node services/activity-service/src/index.js",
    "dev:frontend": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "test": "node --test tests/unit.test.js",
    "test:e2e": "node --test tests/api.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5"
  }
}
